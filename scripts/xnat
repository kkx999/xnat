  while true; do
    echo
    echo "================================"
    echo "        XNAT 管理脚本"
    echo "================================"
    echo "当前组件：Panel"
    echo "当前版本：v$(current_version panel)"
    echo
    echo "1. 查看运行状态"
    echo "2. 重启 Panel"
    echo "3. 查看实时日志"
    echo "4. 域名与 HTTPS"
    echo "5. 数据库备份 / 恢复"
    echo "6. 检查 / 更新 Panel"
    echo "7. 查看 XNAT 防火墙"
    echo "8. 系统诊断"
    echo "9. 卸载 Panel"
    echo "0. 退出"
    read -r -p "请选择: " n
    case "$n" in
      1) cmd_panel_status ;;
      2) cmd_restart ;;
      3) cmd_logs ;;
      4) interactive_domain ;;
      5) interactive_backup ;;
      6) interactive_update ;;
      7) cmd_firewall status ;;
      8) cmd_doctor ;;
      9) cmd_uninstall ;;
      0) exit 0 ;;
      *) echo "无效选择" ;;
    esac
  done
}

interactive_host_menu(){
  while true; do
    echo
    echo "================================"
    echo "        XNAT 管理脚本"
    echo "================================"
    echo "当前组件：Host Agent"
    echo "当前版本：v$(current_version host)"
    echo "Agent API：v$(current_agent_api_version)"
    echo
    echo "1. 查看运行状态"
    echo "2. 重启 Host Agent"
    echo "3. 查看实时日志"
    echo "4. 查看 XNAT 防火墙"
    echo "5. 修改允许的 Panel IP"
    echo "6. 轮换 Agent Token"
    echo "7. 检查 / 更新 Host Agent"
    echo "8. 系统诊断"
    echo "9. 卸载 Host Agent"
    echo "0. 退出"
    read -r -p "请选择: " n
    case "$n" in
      1) cmd_host_status ;;
      2) cmd_restart ;;
      3) cmd_logs ;;
      4) cmd_firewall status ;;
      5) cmd_set_panel_ip ;;
      6) cmd_token_rotate ;;
      7) interactive_update ;;
      8) cmd_doctor ;;
      9) cmd_uninstall ;;
      0) exit 0 ;;
      *) echo "无效选择" ;;
    esac
  done
}

interactive_menu(){
  case "$(detect_role)" in
    panel) interactive_panel_menu ;;
    host) interactive_host_menu ;;
  esac
}

case "${1:-}" in
  "") need_root; interactive_menu ;;
  init) shift; cmd_init "$@" ;;
  version) shift; cmd_version ;;
  status) shift; cmd_status "$@" ;;
  restart) shift; cmd_restart "$@" ;;
  logs) shift; cmd_logs "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  backup)
    shift
    case "${1:-}" in
      "") cmd_backup ;;
      list) shift; cmd_backup_list "$@" ;;
      *) die "用法：xnat backup [list]" ;;
    esac
    ;;
  restore) shift; cmd_restore "$@" ;;
  update) shift; cmd_update "$@" ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  token)
    [[ "$(detect_role)" == host ]] || die "token 命令仅适用于 Host Agent"
    shift
    case "${1:-}" in
      rotate) shift; cmd_token_rotate "$@" ;;
      *) die "用法：xnat token rotate" ;;
    esac
    ;;
  panel-ip)
    [[ "$(detect_role)" == host ]] || die "panel-ip 命令仅适用于 Host Agent"
    shift; cmd_set_panel_ip "$@"
    ;;
  firewall) shift; cmd_firewall "$@" ;;
  domain)
    [[ "$(detect_role)" == panel ]] || die "domain 命令仅适用于 Panel"
    shift
    case "${1:-}" in
      "") need_root; interactive_domain ;;
      set) shift; cmd_domain_set "$@" ;;
      status) shift; cmd_domain_status "$@" ;;
      renew) shift; cmd_domain_renew "$@" ;;
      remove) shift; cmd_domain_remove "$@" ;;
      *) die "用法：xnat domain [set|status|renew|remove]" ;;
    esac
    ;;
  cloudflare)
    [[ "$(detect_role)" == panel ]] || die "cloudflare 命令仅适用于 Panel"
    shift
    case "${1:-}" in
      refresh) shift; cmd_cloudflare_refresh "$@" ;;
      protect) shift; cmd_cloudflare_protect "$@" ;;
      *) die "用法：xnat cloudflare [refresh|protect]" ;;
    esac
    ;;
  *) die "用法：xnat [version|status|restart|logs|doctor|backup|restore|update|token|panel-ip|firewall|domain|cloudflare|uninstall]" ;;
esac
